<Window x:Class="Internship_WPF_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Internship_WPF_Project"
        mc:Ignorable="d" MouseLeftButtonDown="Window_MouseLeftButton"
        Title="MainWindow" Height="600" Width="800" ResizeMode="NoResize">
        
       

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition />
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>

        <Rectangle Fill="#2f4f4f" />
        <Rectangle Grid.Row="2" Fill="Black" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="60" >
            <Button Height="20" Width="20" Background="Yellow" Click="btnMinimize_Click" Content="-" Foreground="Black"/>
            <Button Height="20" Width="20" Background="Blue" Click="btnMaximize_Click" Content="⬜" Foreground="Black"/>
            <Button Height="20" Width="20" Background="Red" Click="btnClose_Click" Content="X" Foreground="Black"/>
        </StackPanel>

        

        <Label Grid.Row="2" Content="ROBOCAM PLUS" HorizontalAlignment="Center" Foreground="White"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="#00868b" />
            <Rectangle Grid.Column="1" Fill="#a2b5cd" />

            <StackPanel Orientation="Horizontal"  VerticalAlignment="Top" Width="150" Height="20" Background="White" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" MaxWidth="145"/>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Rectangle Fill="Green" />
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Gray"/>
                </Grid>

            </StackPanel>
        </Grid>
        
        

    </Grid>
</Window>
    
    
    
