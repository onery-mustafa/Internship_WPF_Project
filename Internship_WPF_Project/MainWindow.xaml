                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Horizontal" >
                    <StackPanel>
                        <Border Background="#3D517D" Width="150" Height="30" CornerRadius="10,10,10,10" BorderBrush="AliceBlue" BorderThickness="1">
                            <Label Content="Select Mode" Foreground="White" HorizontalContentAlignment="Center"/>
                        </Border>

                        <Border Background="#3D517D" Width="150" Height="120" CornerRadius="10,10,10,10" >
                            <StackPanel VerticalAlignment="Center">
                                <Button x:Name="btnMode1" Content="Manual" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="btnMode1_Click"/>
                                <Button x:Name="btnMode2" Content="Auto" Background="Transparent" Foreground="White" BorderBrush="Transparent" Click="btnMode2_Click"/>
                                <Button x:Name="btnMode3" Content="Mode 3" Background="Transparent" Foreground="White" BorderBrush="Transparent" />
                                <Button x:Name="btnMode4" Content="Mode 4" Background="Transparent" Foreground="White" BorderBrush="Transparent" />
