<Window x:Class="Internship_WPF_Project.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Internship_WPF_Project"
        mc:Ignorable="d" MouseLeftButtonDown="Window_MouseLeftButton" WindowStartupLocation="CenterScreen"
        Title="MainWindow" Height="600" Width="800" ResizeMode="NoResize">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="80" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Background="Black">
            <TextBlock Height="20" Width="760" Text="ROBOCAM PLUS" Foreground="White" TextAlignment="Center" />
            <Button Height="20" Width="20" Background="Blue" Click="btnMinimize_Click" Content="-" Foreground="Black"/>
            <Button Height="20" Width="20" Background="Red" Click="btnClose_Click" Content="X" Foreground="Black"/>
        </StackPanel>

        <Rectangle Grid.Row="1" Fill="#2f4f4f" />

        <Border Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Left" BorderBrush="AliceBlue" BorderThickness="1" Width="250" Height="30">
            <StackPanel Orientation="Horizontal" >
                <Label Content="Program Name: " Foreground="AliceBlue"/>
                <TextBlock x:Name="txtProgramName" Foreground="AliceBlue" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    
        <StackPanel Grid.Row="1"  VerticalAlignment="Center" HorizontalAlignment="Right">
            <Button x:Name="btnSignIn" Width="100" Height="25" Content="Sign In" Background="Transparent" Foreground ="AliceBlue" BorderBrush="AliceBlue" Click="btnSignIn_Click" />
            <Button x:Name="btnIP" Width="100" Height="25" Content="Connect" Background="Transparent" Foreground ="AliceBlue" BorderBrush="AliceBlue" Click="btnIP_Click" />

            <Border BorderBrush="AliceBlue" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Height="25" Width="100" >
                    <Label HorizontalAlignment="Left" VerticalAlignment="Center" Content="IP: " Foreground="White" Background="Transparent" />
                    <TextBlock Name="txtIP" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Text="No Found"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" Fill="#00868b" />
            <Rectangle Grid.Column="1" Fill="#a2b5cd" />

            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="630">
                <Border Height="30" Background="#333333" CornerRadius="10,10,10,10" BorderBrush="AliceBlue" BorderThickness="1">
                    <Label Content="Alarm Messages" Foreground="White" HorizontalAlignment="Center"/>
                    
                </Border>

                <Border Height="100" Background="#333333" CornerRadius="10,10,10,10">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel HorizontalAlignment="Left" >
                          <!--  <TextBlock x:Name="txtAlarm" Width="100" Foreground="AliceBlue"/> -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Panel.ZIndex="2">
                                <ListView x:Name="listAlarmMesages" Width="530" Height="100" Background="Transparent" Foreground="AliceBlue"/>
                            </ScrollViewer>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" Width="100" Height="100">
                            <Button x:Name="btnAlarmsClear" Content="Reset Alarms" Height="50" Background="Transparent" Foreground="White" BorderBrush="AliceBlue" BorderThickness="1" Click="btnAlarmsClear_Click"/>
                            <Button x:Name="btnAlarm" Content="Copy Alarms" Height="50" Background="Transparent" Foreground="White" BorderBrush="AliceBlue" BorderThickness="1"/>
                        </StackPanel>
                     </StackPanel>
                    
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Button Name="btnRun" Width="42.5" Height="42.5" Content="Run" Background="#1c0f45" Foreground="White" BorderBrush="Black" Click="btnRun_Click" />
                    <Button Name="btnStop" Width="42.5" Height="42.5" Content="Stop" Background="#1c0f45" Foreground="White" BorderBrush="Black" />
                    <Button Name="btnCancel" Width="42.5" Height="42.5" Content="Cancel" Background="#1c0f45" Foreground="White" BorderBrush="Black" />
                    <Button Name="btnRestart" Width="42.5" Height="42.5" Content="Restart" Background="#1c0f45" Foreground="White" BorderBrush="Black" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Width="170" Height="35" Background="LightGray" >
                    <TextBlock Height="35" Width="25" Background="Black" Foreground="White" Text="{Binding SpeedValue_percent, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="Speed" Width="{Binding SpeedValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="140"/>
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Rectangle Fill="Green" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Gray"/>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" >
                
                <Border Width="170" Height="30"  Margin="0,0,0,10" CornerRadius="10,10,10,10" Background="#1c0f45">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="User Frame =  " Foreground="AliceBlue" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UFNum, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Foreground="AliceBlue"/>
                    </StackPanel>
                </Border>
                
                <StackPanel>
                    <Grid Height="200" Width="170">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Rectangle Grid.Column="0" Grid.Row="0" Fill="#1c0f45"   RadiusX="10" RadiusY="10"/>
                        <Rectangle Grid.Column="1" Grid.Row="0" Fill="#1c0f45"  RadiusX="10" RadiusY="10"/>
                        <Rectangle Grid.Column="0" Grid.Row="1" Fill="#1c0f45"  Stroke="AliceBlue" RadiusX="10" RadiusY="10"/>
                        <Rectangle Grid.Column="1" Grid.Row="1" Fill="#1c0f45" Stroke="AliceBlue" RadiusX="10" RadiusY="10"/>

                        <Label Content="User Position" Foreground="AliceBlue" />
                        <Label Grid.Column="1" Content="Joint Position" Foreground="AliceBlue" />

                        <Grid Grid.Row="1" Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="X :" Foreground="White" />
                            <Label Grid.Row="1" Grid.Column="0" Content="Y :" Foreground="White" />
                            <Label Grid.Row="2" Grid.Column="0" Content="Z :" Foreground="White" />
                            <Label Grid.Row="3" Grid.Column="0" Content="W :" Foreground="White" />
                            <Label Grid.Row="4" Grid.Column="0" Content="P :" Foreground="White" />
                            <Label Grid.Row="5" Grid.Column="0" Content="R :" Foreground="White" />

                            <Label Grid.Row="0" Grid.Column="1" Content="{Binding X_Pos}" Foreground="White" />
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding Y_Pos}" Foreground="White" />
                            <Label Grid.Row="2" Grid.Column="1" Content="{Binding Z_Pos}" Foreground="White" />
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding W_Pos}" Foreground="White" />
                            <Label Grid.Row="4" Grid.Column="1" Content="{Binding P_Pos}" Foreground="White" />
                            <Label Grid.Row="5" Grid.Column="1" Content="{Binding R_Pos}" Foreground="White" />
                        </Grid>

                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Content="J1 :" Foreground="White" />
                            <Label Grid.Row="1" Grid.Column="0" Content="J2 :" Foreground="White" />
                            <Label Grid.Row="2" Grid.Column="0" Content="J3 :" Foreground="White" />
                            <Label Grid.Row="3" Grid.Column="0" Content="J4 :" Foreground="White" />
                            <Label Grid.Row="4" Grid.Column="0" Content="J5 :" Foreground="White" />
                            <Label Grid.Row="5" Grid.Column="0" Content="J6 :" Foreground="White" />

                            <Label Grid.Row="0" Grid.Column="1" Content="{Binding J1_Pos}" Foreground="White" />
                            <Label Grid.Row="1" Grid.Column="1" Content="{Binding J2_Pos}" Foreground="White" />
                            <Label Grid.Row="2" Grid.Column="1" Content="{Binding J3_Pos}" Foreground="White" />
                            <Label Grid.Row="3" Grid.Column="1" Content="{Binding J4_Pos}" Foreground="White" />
                            <Label Grid.Row="4" Grid.Column="1" Content="{Binding J5_Pos}" Foreground="White" />
                            <Label Grid.Row="5" Grid.Column="1" Content="{Binding J6_Pos}" Foreground="White" />

                        </Grid>
                    </Grid>
                </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="10"/>
                    <RowDefinition />
                    <RowDefinition Height="10"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Left" >
          
                        <Border  Background="#3D517D" Width="150" Height="30" CornerRadius="10,10,10,10"  HorizontalAlignment="Left">
                            <Label Content="Set Num Registers" FontSize="15" Foreground="AliceBlue" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                    <Border Background="LightGray" Width="150" Height="30" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtNumRegSet" Width="120" Background="Transparent" Margin="3,3,0,3" BorderBrush="Transparent"/>
                                <Button  x:Name="btnNumRegSet" Content="OK" Background="Transparent" Margin="0,3,3,3" BorderBrush="Transparent" Click="btnNumRegSet_Click"/>
                            </StackPanel>
                        </Border>

                    <Border Background="AliceBlue" Width="150" Height="100" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="3">
                                <ListView Name="numRegValues" Grid.Row="1" Grid.ColumnSpan="2" SelectionMode="Single" />
                            </ScrollViewer>
                        </Border>

                    <Border Background="#3D517D" Width="610" Height="30" CornerRadius="10,10,10,10"  Margin="0,10,0,0" HorizontalAlignment="Left">
                        <Label Content="Set Position Registers" FontSize="15" Foreground="AliceBlue" HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J1=" FontSize="10" Width="25"/>
                                <TextBox x:Name="txtPosRegSet_J1" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center" />
                                <Button  x:Name="btnPosRegSet_J1" Width="20" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J1_Click" />
                            </StackPanel>
                        </Border>

                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J2=" FontSize="10"/>
                                <TextBox x:Name="txtPosRegSet_J2" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center"/>
                                <Button  x:Name="btnPosRegSet_J2" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J2_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J3=" FontSize="10"/>
                                <TextBox x:Name="txtPosRegSet_J3" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center"/>
                                <Button  x:Name="btnPosRegSet_j3" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J3_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J4=" FontSize="10"/>
                                <TextBox x:Name="txtPosRegSet_J4" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center"/>
                                <Button  x:Name="btnPosRegSet_J4" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J4_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J5=" FontSize="10"/>
                                <TextBox x:Name="txtPosRegSet_J5" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center"/>
                                <Button  x:Name="btnPosRegSet_J5" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J5_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="LightGray"  Height="30" Width="101.667" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left" >
                            <StackPanel Orientation="Horizontal">
                                <Label Content="J6=" FontSize="10"/>
                                <TextBox x:Name="txtPosRegSet_J6" Width="53" Background="Transparent"  BorderBrush="Transparent" VerticalContentAlignment="Center"/>
                                <Button  x:Name="btnPosRegSet_J6" Content="OK" FontSize="10" Background="Transparent"  BorderBrush="Transparent" Click="btnPosRegSet_J6_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Background="AliceBlue" Width="610" Height="110" CornerRadius="10,10,10,10" BorderBrush="#3D517D" BorderThickness="3" HorizontalAlignment="Left">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="3">
                            <ListView x:Name="posRegValues" Grid.Row="1" Grid.ColumnSpan="2" SelectionMode="Single" />
                        </ScrollViewer>
                    </Border>





                </StackPanel>

            </Grid>

        </Grid>
        
        

    </Grid>
</Window>
    
    
    
