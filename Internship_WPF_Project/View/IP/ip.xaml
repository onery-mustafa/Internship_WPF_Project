<Window x:Class="Internship_WPF_Project.View.IP.ip"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Internship_WPF_Project.View.IP"
        xmlns:TextBox="clr-namespace:Internship_WPF_Project.View.SignIn"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        Title="ip" Height="150" Width="300">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="#333333">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBox:textbox x:Name="ipInput" Grid.Row="0" Width="250" Height="40" Placeholder="IP Adress" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button  Name="btnOK" Content="Connect" Width="80" Height="30" Click="btnOK_Click"/>
            <Button  Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="40,0,0,0" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
