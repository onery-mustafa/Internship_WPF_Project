<Window x:Class="Internship_WPF_Project.View.SignIn.signin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Internship_WPF_Project.View.SignIn"
        xmlns:TextBox="clr-namespace:Internship_WPF_Project.View.SignIn"
        mc:Ignorable="d"
        Title="signin" Height="200" Width="300">
    
    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" />
    </WindowChrome.WindowChrome>

    <Grid Background="#333333">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="65"/>
            <RowDefinition />   
        </Grid.RowDefinitions>

        <TextBox:textbox Grid.Row="0" Width="250" Height="40" Placeholder="User Name" />
        <TextBox:textbox Grid.Row="1" Width="250" Height="40" Placeholder="Password" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button  Name="btnOK" Content="OK" Width="80" Height="30" Click="btnOK_Click"/>
            <Button  Name="btnCancel" Content="Cancel" Width="80" Height="30" Margin="40,0,0,0" Click="btnCancel_Click"/>
        </StackPanel>
        
    </Grid>
</Window>
